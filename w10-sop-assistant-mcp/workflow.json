      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search the Media Operations standard operating procedures (SOPs): QC holds, the mezzanine file spec, the encoding ladder, captions, file naming, delivery deadlines, redelivery, promos and trailers, and on call escalation. Input is a natural language search query. Returns up to 4 passages, each with its text and metadata: the source file name, doc ID, version, effective date and status. Superseded editions are excluded; a status of 'unknown' means the edition was never confirmed as current, so say so if you use it. Cite the source file name for every fact you use. If no passage answers the question, say the SOPs do not cover it rather than guessing.",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "sop_corpus"
        },
        "topK": 4,
        "includeDocumentMetadata": true,
        "options": {
          "searchFilterJson": "{\n  \"should\": [\n    {\n      \"key\": \"metadata.status\",\n      \"match\": {\n        \"value\": \"current\"\n      }\n    },\n    {\n      \"key\": \"metadata.status\",\n      \"match\": {\n        \"value\": \"unknown\"\n      }\n    }\n  ]\n}"
        }
      },
