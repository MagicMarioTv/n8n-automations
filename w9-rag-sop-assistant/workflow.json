      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "// One item comes out of the vector store per stored chunk. Count them per source file.\nconst perFile = {};\nfor (const item of $input.all()) {\n  const src = item.json.metadata?.source ?? 'unknown';\n  perFile[src] = (perFile[src] || 0) + 1;\n}\nreturn [{ json: { chunks: $input.all().length, files: Object.keys(perFile).length, perFile } }];\n"
      }
    },
