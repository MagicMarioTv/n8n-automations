    {
      "id": "417c548b-4bc9-4f14-9e0c-c5c701bd545f",
      "name": "Split Docs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// The webhook body carries every SOP as { filename, text }.\n// Read it from the trigger by name: the reset node before this one replaced the item with Qdrant's reply.\nconst docs = $('Ingest Request').first().json.body.docs || [];\n\n// Each SOP opens with a header line like:\n//   **Doc ID:** SOP-QC-002 · **Version:** 2.1 · **Effective:** 2025-03-15 · **Status:** SUPERSEDED by SOP-QC-003 on 2026-06-01\n// Pull those facts out so every chunk can carry them, not only the chunk the header lands in.\nconst field = (text, label) => {\n  const m = text.match(new RegExp('\\\\*\\\\*' + label + ':\\\\*\\\\*\\\\s*([^·\\\\n]+)'));\n  return m ? m[1].trim() : '';\n};\n\nreturn docs.map(d => {\n  const statusText = field(d.text, 'Status');\n  return {\n    json: {\n      filename: d.filename,\n      text: d.text,\n      doc_id: field(d.text, 'Doc ID'),\n      version: field(d.text, 'Version'),\n      effective: field(d.text, 'Effective'),\n      // Anything without an explicit SUPERSEDED status is the current edition.\n      status: /superseded/i.test(statusText) ? 'superseded: ' + statusText.replace(/^SUPERSEDED\\s*/i, '') : 'current',\n    },\n  };\n});\n"
      }
    },
